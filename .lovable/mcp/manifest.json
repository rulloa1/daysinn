{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jazrkvkzfpfuwzatsefb.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "daysinn",
      "version": "0.1.0",
      "title": "daysInn"
    },
    "tools": [
      {
        "name": "property_summary",
        "title": "Property summary",
        "description": "Snapshot of the property: open vs resolved requests, room status counts, and rooms flagged do-not-disturb.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_requests",
        "title": "List guest requests",
        "description": "List guest service requests (towels, housekeeping, repairs, front desk) with their current status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "default": "all",
              "description": "Filter by workflow status.",
              "type": "string",
              "enum": ["new", "in_progress", "resolved", "all"]
            },
            "room": {
              "description": "Only requests for this room number.",
              "type": "string"
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_rooms",
        "title": "List rooms",
        "description": "List rooms on the front-desk board with housekeeping status, floor, occupancy and assignment. Guest names are masked for non-staff roles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by room status, e.g. clean, dirty, occupied.",
              "type": "string"
            },
            "floor": {
              "description": "Only rooms on this floor.",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "limit": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "update_request_status",
        "title": "Update request status",
        "description": "Move a guest request through the workflow (new, in_progress, resolved). Requires a staff or manager role.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Request id from list_requests."
            },
            "status": {
              "type": "string",
              "enum": ["new", "in_progress", "resolved"]
            },
            "note": {
              "description": "Optional note recorded with the change.",
              "type": "string",
              "maxLength": 500
            }
          },
          "required": ["request_id", "status"]
        },
        "outputSchema": null
      },
      {
        "name": "update_room_status",
        "title": "Update room status",
        "description": "Set the housekeeping status of a room (and optionally the do-not-disturb flag). Requires a staff or manager role.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "room_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "description": "Room number, e.g. 214."
            },
            "status": {
              "type": "string",
              "enum": [
                "clean",
                "dirty",
                "in_progress",
                "inspected",
                "out_of_order",
                "occupied",
                "vacant"
              ],
              "description": "New room status."
            },
            "dnd": {
              "description": "Set the do-not-disturb flag.",
              "type": "boolean"
            }
          },
          "required": ["room_number", "status"]
        },
        "outputSchema": null
      }
    ]
  }
}
