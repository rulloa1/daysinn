# Copy to .env (or add as Secrets in your host) and fill in real values.
# NEVER commit real values. No secret in this file should have a value here.

# --- Backend (Lovable Cloud / Supabase) -------------------------------------
# Browser-safe, publishable values. Injected automatically by Lovable Cloud.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side equivalents (used by server functions / SSR).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# SERVER ONLY. Bypasses row-level security. Never expose to browser code and
# never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web push (housekeeping background alerts) ------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret for POST /api/public/push-dispatch. The database also stores a
# copy in public.internal_secrets; the env var is a fallback.
PUSH_DISPATCH_SECRET=

# --- Optional integrations ---------------------------------------------------
LOVABLE_API_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
